{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "UnifiedGateway": "Information"
    }
  },
  "AllowedHosts": "localhost",
  "Gateway": {
    "Aws": {
      "//": "Defaults. A deployment overrides these per environment; the placeholders below are refused at startup so an unsubstituted template cannot reach AWS.",
      "Region": "us-east-1",
      "CredentialSource": "RolesAnywhere",
      "RolesAnywhere": {
        "TrustAnchorArn": "arn:aws:rolesanywhere:us-east-1:<account-id>:trust-anchor/<trust-anchor-id>",
        "ProfileArn": "arn:aws:rolesanywhere:us-east-1:<account-id>:profile/<profile-id>",
        "RoleArn": "arn:aws:iam::<account-id>:role/BedrockGatewayExecutionRole",
        "SessionName": "unified-gateway",
        "DurationSeconds": 3600,
        "Certificate": {
          "Source": "WindowsStore",
          "StoreLocation": "LocalMachine",
          "StoreName": "My",
          "Thumbprint": "<client-certificate-thumbprint>",
          "IncludeChain": true
        }
      },
      "AssumeRoleArn": "",
      "RoleSessionName": "UnifiedGatewaySession",
      "SessionDurationSeconds": 3600,
      "LocalProfileName": "default",
      "UseLocalProfile": false,
      "ExternalId": null,
      "RefreshBufferMinutes": 5
    },
    "LocalProviders": {
      "//TimeoutSeconds": "Local generation is linear in max tokens. Measured ~5.4 tok/s for a 27B model on a workstation, so a 2048-token budget needs ~380s. Size this to the largest MaxTokens an application here may request. Note the real control is the application's MaxTokens: a 6-minute synchronous request is a poor interactive experience whatever the timeout says.",
      "Ollama": {
        "BaseUrl": "http://localhost:11434",
        "TimeoutSeconds": 600,
        "Enabled": true
      },
      "LmStudio": {
        "BaseUrl": "http://localhost:1234",
        "TimeoutSeconds": 600,
        "Enabled": true
      },
      "LlamaCpp": {
        "BaseUrl": "http://localhost:8080",
        "TimeoutSeconds": 600,
        "Enabled": true
      }
    },
    "Security": {
      "EnforceAppApiKey": true,
      "RateLimitPerMinute": 120,
      "AllowedCorsOrigins": [],
      "MaxInputCharacters": 100000,
      "MaxTokensCeiling": 8192,
      "MaxRequestBodyBytes": 1048576,
      "TokenRateLimitPerMinute": 10,
      "ManagementRateLimitPerMinute": 60,
      "DefaultStsTokenLifetimeSeconds": 900,
      "MaxStsTokenLifetimeSeconds": 3600,
      "//MaxAdminStsTokenLifetimeSeconds": "Admin tokens can only be minted from the break-glass credential; they get the shorter ceiling.",
      "MaxAdminStsTokenLifetimeSeconds": 900,
      "//RequireHttps": "HSTS, browser redirect to HTTPS, and API calls over plain HTTP refused with HTTPS_REQUIRED. Only Development may turn it off.",
      "RequireHttps": true,
      "HstsMaxAgeDays": 365,
      "RegexTimeoutMs": 250
    },
    "Storage": {
      "DataDirectory": "./data",
      "RegistryFileName": "app_registry.json",
      "AuditLogEnabled": true,
      "AuditDirectory": "audit",
      "AuditRetentionDays": 90
    },
    "Guardrails": {
      "Enabled": true,
      "Mode": "Redact",
      "Pci": {
        "Enabled": true,
        "MaskCreditCards": true,
        "MaskIban": true,
        "MaskCvv": true
      },
      "Pii": {
        "Enabled": true,
        "MaskSsn": true,
        "MaskEmails": true,
        "MaskPhoneNumbers": true,
        "MaskPassports": true
      },
      "Secrets": {
        "Enabled": true,
        "MaskAwsKeys": true,
        "MaskPrivateKeys": true,
        "MaskJwtTokens": true,
        "MaskGenericApiKeys": true
      },
      "PromptInjection": {
        "Enabled": true,
        "BlockJailbreaks": true,
        "BlockSystemOverrides": true
      },
      "BedrockGuardrails": {
        "Enabled": false,
        "GuardrailIdentifier": "",
        "GuardrailVersion": "DRAFT"
      },
      "OutputScanning": {
        "Enabled": true,
        "Mode": "Redact",
        "ScanPci": true,
        "ScanPii": true,
        "ScanSecrets": true
      }
    },
    "Cloud": {
      "Provider": "Aws",
      "BedrockServiceUrl": "",
      "Simulator": {
        "IamUrl": "http://localhost:5001",
        "S3Url": "http://localhost:5002",
        "KmsUrl": "http://localhost:5003",
        "BedrockUrl": "http://localhost:5004",
        "TimeoutSeconds": 10,
        "CallerRoleName": "KmsCryptoRole"
      },
      "Secrets": {
        "AdminApiKeyName": "/gateway/admin-api-key",
        "StsSigningKeyName": "/gateway/sts-signing-key",
        "CacheSeconds": 300
      },
      "Crypto": {
        "KeyId": "default",
        "EncryptionContext": {
          "application": "UnifiedLLMGateway"
        }
      },
      "AccessControl": {
        "Enabled": true,
        "ServicePrefix": "gateway",
        "ResourceArnTemplate": "arn:aws:gateway:us-east-1:123456789012:application/{0}",
        "DecisionCacheSeconds": 30,
        "AdminRoleArns": [],
        "//BreakGlassPrincipalArn": "Template. The principal the break-glass key, and every admin STS token minted from it, acts as. Required outside Development; startup refuses the placeholder.",
        "BreakGlassPrincipalArn": "arn:aws:iam::<account-id>:role/GatewayBreakGlassRole"
      },
      "AwsIdentity": {
        "//": "Automation proves an IAM identity to /api by sending a SigV4-signed sts:GetCallerIdentity request in X-Gateway-Aws-Identity. The gateway relays it to STS and trusts only the ARN STS returns. Off by default; see docs/aws-iam-authentication.md.",
        "Enabled": false,
        "ServerId": "",
        "AllowedAccountIds": [],
        "AllowedStsHosts": [],
        "MaxRequestAgeSeconds": 300,
        "CacheSeconds": 60,
        "TimeoutSeconds": 10
      },
      "//": "Base defaults. Each environment file sets Provider explicitly; nothing here assumes a simulator is running.",
      "LocalDotNet": {
        "S3Url": "http://localhost:5001",
        "KmsUrl": "http://localhost:5002",
        "IamUrl": "http://localhost:5003",
        "TimeoutSeconds": 10,
        "SecretsBucket": "gateway-secrets",
        "KeyId": "alias/dev-master-key"
      },
      "Storage": {
        "//": "Billing and telemetry are read from this bucket. S3 objects are immutable, so records are batched into whole objects under audit/dt=YYYY-MM-DD/ rather than appended.",
        "Bucket": "gateway-telemetry",
        "FlushIntervalSeconds": 30,
        "FlushBatchSize": 100,
        "RetentionDays": 90,
        "RecentBufferSize": 500
      }
    },
    "Okta": {
      "//": "Template. The simulator is Development-only (appsettings.Development.json switches it on, startup refuses it anywhere else). Every other environment validates tokens from the real tenant, and startup refuses these placeholders until they are substituted.",
      "Enabled": false,
      "Issuer": "https://<your-tenant>.okta.com/oauth2/default",
      "Audience": "unified-gateway",
      "TokenLifetimeMinutes": 60,
      "MetadataAddress": "https://<your-tenant>.okta.com/oauth2/default/.well-known/openid-configuration",
      "GroupsClaim": "groups",
      "ClockSkewSeconds": 60,
      "GroupRoleMappings": {
        "UnifiedGateway-Admins": "arn:aws:iam::<account-id>:role/GatewayPlatformAdminRole",
        "UnifiedGateway-Developers": "arn:aws:iam::<account-id>:role/GatewayDeveloperRole"
      }
    },
    "Billing": {
      "Currency": "USD",
      "//DefaultCosts": "Applied when an application has no rate card, or a request carries no application. Such charges are flagged as estimated.",
      "DefaultInputCostPerMillion": 0.0,
      "DefaultOutputCostPerMillion": 0.0,
      "DailyWindowDays": 30,
      "WeeklyWindowWeeks": 12,
      "MonthlyWindowMonths": 12,
      "MonthlyBudget": 0.0
    }
  }
}
