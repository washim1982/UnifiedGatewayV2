{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "UnifiedGateway": "Debug"
    }
  },
  "Gateway": {
    "Aws": {
      "Region": "us-east-1",
      "AssumeRoleArn": "",
      "RoleSessionName": "DevLocalGatewaySession",
      "SessionDurationSeconds": 3600,
      "LocalProfileName": "default",
      "UseLocalProfile": false,
      "ExternalId": null,
      "RefreshBufferMinutes": 5
    },
    "LocalProviders": {
      "Ollama": {
        "BaseUrl": "http://localhost:11434",
        "TimeoutSeconds": 60,
        "Enabled": true
      },
      "LmStudio": {
        "BaseUrl": "http://localhost:1234",
        "TimeoutSeconds": 60,
        "Enabled": true
      },
      "LlamaCpp": {
        "BaseUrl": "http://localhost:8080",
        "TimeoutSeconds": 60,
        "Enabled": true
      }
    },
    "Security": {
      "AdminApiKey": "",
      "EnforceAppApiKey": true,
      "RateLimitPerMinute": 1000,
      "AllowedCorsOrigins": [
        "http://localhost:3000",
        "http://localhost:5173"
      ],
      "RequireHttps": false
    },
    "Storage": {
      "DataDirectory": "./data/dev",
      "RegistryFileName": "app_registry_dev.json"
    },
    "Guardrails": {
      "Enabled": true,
      "Mode": "Redact",
      "Pci": {
        "Enabled": true,
        "MaskCreditCards": true,
        "MaskIban": true,
        "MaskCvv": true
      },
      "Pii": {
        "Enabled": true,
        "MaskSsn": true,
        "MaskEmails": true,
        "MaskPhoneNumbers": true,
        "MaskPassports": true
      },
      "Secrets": {
        "Enabled": true,
        "MaskAwsKeys": true,
        "MaskPrivateKeys": true,
        "MaskJwtTokens": true,
        "MaskGenericApiKeys": true
      },
      "PromptInjection": {
        "Enabled": true,
        "BlockJailbreaks": true,
        "BlockSystemOverrides": true
      },
      "BedrockGuardrails": {
        "Enabled": false,
        "GuardrailIdentifier": "",
        "GuardrailVersion": "DRAFT"
      }
    },
    "Cloud": {
      "Provider": "Simulator",
      "BedrockServiceUrl": "http://localhost:5004",
      "AccessControl": {
        "Enabled": false,
        "AdminRoleArns": [
          "arn:aws:iam::123456789012:role/KmsCryptoRole"
        ]
      }
    },
    "Okta": {
      "Enabled": true,
      "Issuer": "https://okta-sim.local/oauth2/default",
      "Audience": "unified-gateway",
      "TokenLifetimeMinutes": 60,
      "MetadataAddress": "",
      "GroupsClaim": "groups",
      "ClockSkewSeconds": 60,
      "GroupRoleMappings": {
        "UnifiedGateway-Admins": "arn:aws:iam::123456789012:role/GatewayPlatformAdminRole",
        "UnifiedGateway-Developers": "arn:aws:iam::123456789012:role/GatewayDeveloperRole"
      }
    }
  }
}
