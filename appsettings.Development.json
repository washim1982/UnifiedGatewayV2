{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "UnifiedGateway": "Debug"
    }
  },
  "Gateway": {
    "Aws": {
      "Region": "us-east-1",
      "AssumeRoleArn": "arn:aws:iam::123456789012:role/DevBedrockGatewayRole",
      "RoleSessionName": "DevLocalGatewaySession",
      "SessionDurationSeconds": 3600,
      "LocalProfileName": "default",
      "UseLocalProfile": true,
      "ExternalId": null,
      "RefreshBufferMinutes": 5
    },
    "LocalProviders": {
      "Ollama": {
        "BaseUrl": "http://localhost:11434",
        "TimeoutSeconds": 60,
        "Enabled": true
      },
      "LmStudio": {
        "BaseUrl": "http://localhost:1234",
        "TimeoutSeconds": 60,
        "Enabled": true
      },
      "LlamaCpp": {
        "BaseUrl": "http://localhost:8080",
        "TimeoutSeconds": 60,
        "Enabled": true
      }
    },
    "Security": {
      "AdminApiKey": "ug-dev-admin-key",
      "EnforceAppApiKey": true,
      "RateLimitPerMinute": 1000,
      "AllowedCorsOrigins": [
        "*"
      ]
    },
    "Storage": {
      "DataDirectory": "./data/dev",
      "RegistryFileName": "app_registry_dev.json"
    },
    "Guardrails": {
      "Enabled": true,
      "Mode": "Redact",
      "Pci": {
        "Enabled": true,
        "MaskCreditCards": true,
        "MaskIban": true,
        "MaskCvv": true
      },
      "Pii": {
        "Enabled": true,
        "MaskSsn": true,
        "MaskEmails": true,
        "MaskPhoneNumbers": true,
        "MaskPassports": true
      },
      "Secrets": {
        "Enabled": true,
        "MaskAwsKeys": true,
        "MaskPrivateKeys": true,
        "MaskJwtTokens": true,
        "MaskGenericApiKeys": true
      },
      "PromptInjection": {
        "Enabled": true,
        "BlockJailbreaks": true,
        "BlockSystemOverrides": true
      },
      "BedrockGuardrails": {
        "Enabled": false,
        "GuardrailIdentifier": "",
        "GuardrailVersion": "DRAFT"
      }
    }
  }
}
