<?xml version="1.0" encoding="utf-8"?>
<!-- IIS in-process hosting for the Unified LLM Gateway (ASP.NET Core Module V2).
     Requires the .NET 8 Hosting Bundle on the server. Overlaid onto the publish
     output by publish.ps1. No secret is supplied here or in appsettings: the admin key and
     token signing key live in AWS Secrets Manager, and the host authenticates to AWS with an
     IAM Roles Anywhere certificate. TLS terminates at the site's HTTPS binding, which
     install.ps1 creates; the site has no plain-HTTP binding unless one is asked for. -->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet"
                  arguments=".\UnifiedGatewayV2.dll"
                  hostingModel="inprocess"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
