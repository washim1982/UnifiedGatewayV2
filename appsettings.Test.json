{
  "//": "TEST environment. Runs against the local AWS Simulator (IAM/KMS/S3/Bedrock). The ONLY difference from Production is the Gateway:Cloud block below \u2014 no application code differs between the two.",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "UnifiedGateway": "Debug"
    }
  },
  "AllowedHosts": "localhost;gateway.test.internal",
  "Gateway": {
    "Aws": {
      "//": "Every AWS call this gateway makes -- S3, KMS, Secrets Manager, IAM and Bedrock -- is authorised by the credentials obtained here. The deployment is IIS, so there is no instance or task role to inherit and no access key is stored: the host presents an X.509 certificate to IAM Roles Anywhere and receives credentials that expire.",
      "Region": "us-east-1",
      "CredentialSource": "RolesAnywhere",
      "RolesAnywhere": {
        "TrustAnchorArn": "arn:aws:rolesanywhere:us-east-1:<account-id>:trust-anchor/<trust-anchor-id>",
        "ProfileArn": "arn:aws:rolesanywhere:us-east-1:<account-id>:profile/<profile-id>",
        "RoleArn": "arn:aws:iam::<account-id>:role/BedrockGatewayExecutionRole-test",
        "SessionName": "unified-gateway-test",
        "//DurationSeconds": "AWS accepts 900-3600 for Roles Anywhere regardless of the role's own maximum.",
        "DurationSeconds": 3600,
        "Certificate": {
          "//": "The Windows store keeps the private key non-exportable and owned by the OS; grant the app pool identity read access to it. No key material and no passphrase appears in this file.",
          "Source": "WindowsStore",
          "StoreLocation": "LocalMachine",
          "StoreName": "My",
          "Thumbprint": "<client-certificate-thumbprint>",
          "IncludeChain": true
        }
      },
      "//AssumeRoleArn": "Unused under RolesAnywhere: the session already carries the target role. Set it only to chain into a second role.",
      "AssumeRoleArn": "",
      "RoleSessionName": "UnifiedGatewaySession",
      "SessionDurationSeconds": 3600,
      "UseLocalProfile": false,
      "ExternalId": null,
      "RefreshBufferMinutes": 5
    },
    "LocalProviders": {
      "//TimeoutSeconds": "Local generation is linear in max tokens. Measured ~5.4 tok/s for a 27B model on a workstation, so a 2048-token budget needs ~380s. Size this to the largest MaxTokens an application here may request. Note the real control is the application's MaxTokens: a 6-minute synchronous request is a poor interactive experience whatever the timeout says.",
      "Ollama": {
        "BaseUrl": "http://localhost:11434",
        "TimeoutSeconds": 600,
        "Enabled": true
      },
      "LmStudio": {
        "BaseUrl": "http://localhost:1234",
        "TimeoutSeconds": 600,
        "Enabled": false
      },
      "LlamaCpp": {
        "BaseUrl": "http://localhost:8080",
        "TimeoutSeconds": 600,
        "Enabled": false
      }
    },
    "Security": {
      "EnforceAppApiKey": true,
      "RequireHttps": false,
      "AllowedCorsOrigins": [
        "http://localhost:3000"
      ],
      "RateLimitPerMinute": 300,
      "TokenRateLimitPerMinute": 30,
      "ManagementRateLimitPerMinute": 120,
      "DefaultStsTokenLifetimeSeconds": 900,
      "MaxStsTokenLifetimeSeconds": 3600,
      "MaxInputCharacters": 100000,
      "MaxTokensCeiling": 8192,
      "MaxRequestBodyBytes": 1048576,
      "RegexTimeoutMs": 250
    },
    "Storage": {
      "DataDirectory": "./data/test",
      "RegistryFileName": "app_registry_test.json",
      "AuditLogEnabled": true,
      "AuditDirectory": "audit",
      "AuditRetentionDays": 30
    },
    "//Cloud": "This block, and only this block, differs from Production.",
    "Cloud": {
      "//": "TEST uses real AWS. Identical binary to DEV and PROD; only this block differs.",
      "Provider": "Aws",
      "BedrockServiceUrl": "",
      "Secrets": {
        "AdminApiKeyName": "/gateway/test/admin-api-key",
        "StsSigningKeyName": "/gateway/test/sts-signing-key",
        "CacheSeconds": 60
      },
      "Crypto": {
        "KeyId": "alias/unified-gateway-test",
        "EncryptionContext": {
          "application": "UnifiedLLMGateway",
          "environment": "test"
        }
      },
      "AccessControl": {
        "Enabled": true,
        "ServicePrefix": "gateway",
        "ResourceArnTemplate": "arn:aws:gateway:us-east-1:<account-id>:application/{0}",
        "DecisionCacheSeconds": 30,
        "AdminRoleArns": []
      },
      "Storage": {
        "//": "TEST: real S3. Create the bucket with versioning, SSE-KMS and a lifecycle rule; the gateway never creates it.",
        "Bucket": "unified-gateway-telemetry-test",
        "FlushIntervalSeconds": 30,
        "FlushBatchSize": 100,
        "RetentionDays": 90,
        "RecentBufferSize": 500
      }
    },
    "Guardrails": {
      "Enabled": true,
      "Mode": "Redact",
      "Pci": {
        "Enabled": true,
        "MaskCreditCards": true,
        "MaskIban": true,
        "MaskCvv": true
      },
      "Pii": {
        "Enabled": true,
        "MaskSsn": true,
        "MaskEmails": true,
        "MaskPhoneNumbers": true,
        "MaskPassports": true
      },
      "Secrets": {
        "Enabled": true,
        "MaskAwsKeys": true,
        "MaskPrivateKeys": true,
        "MaskJwtTokens": true,
        "MaskGenericApiKeys": true
      },
      "PromptInjection": {
        "Enabled": true,
        "BlockJailbreaks": true,
        "BlockSystemOverrides": true
      },
      "BedrockGuardrails": {
        "Enabled": false,
        "GuardrailIdentifier": "",
        "GuardrailVersion": "DRAFT"
      },
      "OutputScanning": {
        "Enabled": true,
        "Mode": "Redact",
        "ScanPci": true,
        "ScanPii": true,
        "ScanSecrets": true
      }
    },
    "Okta": {
      "Enabled": false,
      "Issuer": "https://<your-tenant>.okta.com/oauth2/default",
      "Audience": "unified-gateway",
      "TokenLifetimeMinutes": 60,
      "MetadataAddress": "https://<your-tenant>.okta.com/oauth2/default/.well-known/openid-configuration",
      "GroupsClaim": "groups",
      "ClockSkewSeconds": 60,
      "GroupRoleMappings": {
        "UnifiedGateway-Admins": "arn:aws:iam::<account-id>:role/GatewayPlatformAdminRole",
        "UnifiedGateway-Developers": "arn:aws:iam::<account-id>:role/GatewayDeveloperRole"
      }
    },
    "Billing": {
      "Currency": "USD",
      "//DefaultCosts": "Applied when an application has no rate card, or a request carries no application. Such charges are flagged as estimated.",
      "DefaultInputCostPerMillion": 0.0,
      "DefaultOutputCostPerMillion": 0.0,
      "DailyWindowDays": 30,
      "WeeklyWindowWeeks": 12,
      "MonthlyWindowMonths": 12,
      "MonthlyBudget": 0.0
    }
  }
}
