<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Namespaces stay UnifiedGateway.* so existing source files are unaffected. -->
    <RootNamespace>UnifiedGateway</RootNamespace>
    <AssemblyName>UnifiedGatewayV2</AssemblyName>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>

    <!-- Supply chain: fail the build on a known-vulnerable dependency rather than warn.
         A gateway that fronts cloud credentials should not ship on a package with a
         published advisory because nobody read the build log. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <WarningsAsErrors>$(WarningsAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>

    <!-- A lock file makes restores reproducible: the same commit resolves the same
         package versions on every machine and in CI. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="UnifiedGatewayV2.Tests\**" />
    <Content Remove="UnifiedGatewayV2.Tests\**" />
    <EmbeddedResource Remove="UnifiedGatewayV2.Tests\**" />
    <None Remove="UnifiedGatewayV2.Tests\**" />
  </ItemGroup>

  <!-- The local AWS simulator is a separate set of projects under dev\, not part of this
       assembly. Without these removals the SDK's default globs would compile its sources into
       the gateway and copy its appsettings.json over this project's own. -->
  <ItemGroup>
    <Compile Remove="dev\**" />
    <Content Remove="dev\**" />
    <EmbeddedResource Remove="dev\**" />
    <None Remove="dev\**" />
  </ItemGroup>

  <!-- Development launches the simulator as child processes (LocalAwsSimulatorHost), so a Debug
       build has to produce runnable binaries for it. A Release build never builds it: the
       simulator admits any role with Allow */* and must not travel with a production artefact. -->
  <Target Name="BuildLocalAwsSimulator" BeforeTargets="Build" Condition="'$(Configuration)' == 'Debug'">
    <!-- Shared goes first, on its own. All three services reference it, and building them in
         parallel let one service compile against the previous Shared.dll while another was still
         rewriting it - which shows up as a stale-overload error rather than as a build order bug. -->
    <MSBuild Projects="dev\aws-simulator\src\Shared\Shared.csproj"
             Targets="Restore;Build"
             Properties="Configuration=$(Configuration)" />
    <MSBuild Projects="dev\aws-simulator\src\S3Local\S3Local.csproj;dev\aws-simulator\src\KmsLocal\KmsLocal.csproj;dev\aws-simulator\src\IamLocal\IamLocal.csproj"
             Targets="Restore;Build"
             Properties="Configuration=$(Configuration)" />
  </Target>

  <ItemGroup>
    <PackageReference Include="AWSSDK.BedrockRuntime" Version="3.7.404.7" />
    <PackageReference Include="AWSSDK.KeyManagementService" Version="3.7.400.78" />
    <PackageReference Include="AWSSDK.S3" Version="3.7.400.78" />
    <PackageReference Include="AWSSDK.SecretsManager" Version="3.7.400.78" />
    <PackageReference Include="AWSSDK.SecurityToken" Version="3.7.401.4" />
    <PackageReference Include="AWSSDK.Core" Version="3.7.400.78" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.8" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.8" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.7.3" />
    <PackageReference Include="Microsoft.Extensions.Http.Polly" Version="8.0.8" />
    <PackageReference Include="Polly" Version="8.4.1" />
    <PackageReference Include="Polly.Extensions.Http" Version="3.0.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.0.2" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

</Project>
