{
  "//": "On-prem production (Windows Server / IIS). Replace the AWS role ARN and admin key; supply secrets via the site config or app-pool environment, never source control. Data and key-ring paths are relative to the publish folder and must be writable by the IIS app-pool identity (install.ps1 grants this).",

  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Error",
      "UnifiedGateway": "Information"
    }
  },
  "Gateway": {
    "Aws": {
      "Region": "us-east-1",
      "AssumeRoleArn": "arn:aws:iam::<account-id>:role/BedrockGatewayExecutionRole-prod",
      "RoleSessionName": "UnifiedGatewaySession",
      "SessionDurationSeconds": 3600,
      "LocalProfileName": "",
      "UseLocalProfile": false,
      "ExternalId": null,
      "RefreshBufferMinutes": 10
    },
    "LocalProviders": {
      "Ollama": {
        "BaseUrl": "http://ollama.onprem.local:11434",
        "TimeoutSeconds": 120,
        "Enabled": true
      },
      "LmStudio": {
        "BaseUrl": "http://lmstudio.onprem.local:1234",
        "TimeoutSeconds": 120,
        "Enabled": false
      },
      "LlamaCpp": {
        "BaseUrl": "http://llamacpp.onprem.local:8080",
        "TimeoutSeconds": 120,
        "Enabled": false
      }
    },
    "Security": {
      "AdminApiKey": "__PROD_ADMIN_API_KEY_INJECTED_AT_DEPLOY__",
      "EnforceAppApiKey": true,
      "RateLimitPerMinute": 1000,
      "AllowedCorsOrigins": [
        "https://gateway.enterprise.internal",
        "https://ai-platform.enterprise.internal"
      ],
      "MaxInputCharacters": 100000,
      "MaxTokensCeiling": 8192,
      "MaxRequestBodyBytes": 1048576
    },
    "Storage": {
      "DataDirectory": "./data/prod",
      "RegistryFileName": "app_registry_prod.json",
      "AuditLogEnabled": true,
      "AuditDirectory": "audit",
      "AuditRetentionDays": 365
    },
    "Guardrails": {
      "Enabled": true,
      "Mode": "Redact",
      "Pci": { "Enabled": true, "MaskCreditCards": true, "MaskIban": true, "MaskCvv": true },
      "Pii": { "Enabled": true, "MaskSsn": true, "MaskEmails": true, "MaskPhoneNumbers": true, "MaskPassports": true },
      "Secrets": { "Enabled": true, "MaskAwsKeys": true, "MaskPrivateKeys": true, "MaskJwtTokens": true, "MaskGenericApiKeys": true },
      "PromptInjection": { "Enabled": true, "BlockJailbreaks": true, "BlockSystemOverrides": true },
      "BedrockGuardrails": { "Enabled": false, "GuardrailIdentifier": "", "GuardrailVersion": "DRAFT" },
      "OutputScanning": { "Enabled": true, "Mode": "Redact", "ScanPci": true, "ScanPii": true, "ScanSecrets": true }
    }
  }
}
