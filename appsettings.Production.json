{
  "//": "PRODUCTION environment. Identical application binary to TEST. The ONLY difference is the Gateway:Cloud block: Provider flips to Aws, the simulator URLs drop away, and the same seams resolve to KMS, Secrets Manager, IAM and the real Bedrock endpoint. No secret values live in this file.",
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Error",
      "UnifiedGateway": "Information"
    }
  },
  "AllowedHosts": "gateway.enterprise.internal;ai-platform.enterprise.internal",
  "Gateway": {
    "Aws": {
      "Region": "us-east-1",
      "AssumeRoleArn": "arn:aws:iam::<account-id>:role/BedrockGatewayExecutionRole-prod",
      "RoleSessionName": "UnifiedGatewaySession",
      "SessionDurationSeconds": 3600,
      "UseLocalProfile": false,
      "ExternalId": null,
      "RefreshBufferMinutes": 10
    },
    "LocalProviders": {
      "//TimeoutSeconds": "Local generation is linear in max tokens. Measured ~5.4 tok/s for a 27B model on a workstation, so a 2048-token budget needs ~380s. Size this to the largest MaxTokens an application here may request. Note the real control is the application's MaxTokens: a 6-minute synchronous request is a poor interactive experience whatever the timeout says.",
      "Ollama": {
        "BaseUrl": "http://ollama.onprem.local:11434",
        "TimeoutSeconds": 300,
        "Enabled": true
      },
      "LmStudio": {
        "BaseUrl": "http://lmstudio.onprem.local:1234",
        "TimeoutSeconds": 300,
        "Enabled": false
      },
      "LlamaCpp": {
        "BaseUrl": "http://llamacpp.onprem.local:8080",
        "TimeoutSeconds": 300,
        "Enabled": false
      }
    },
    "Security": {
      "EnforceAppApiKey": true,
      "RequireHttps": true,
      "AllowedCorsOrigins": [
        "https://gateway.enterprise.internal",
        "https://ai-platform.enterprise.internal"
      ],
      "RateLimitPerMinute": 1000,
      "TokenRateLimitPerMinute": 20,
      "ManagementRateLimitPerMinute": 60,
      "DefaultStsTokenLifetimeSeconds": 900,
      "MaxStsTokenLifetimeSeconds": 3600,
      "MaxInputCharacters": 100000,
      "MaxTokensCeiling": 8192,
      "MaxRequestBodyBytes": 1048576,
      "RegexTimeoutMs": 250
    },
    "Storage": {
      "DataDirectory": "./data/prod",
      "RegistryFileName": "app_registry_prod.json",
      "AuditLogEnabled": true,
      "AuditDirectory": "audit",
      "AuditRetentionDays": 365
    },
    "//Cloud": "This block, and only this block, differs from Test.",
    "Cloud": {
      "Provider": "Aws",
      "//BedrockServiceUrl": "Empty means the SDK resolves the real regional Bedrock endpoint.",
      "BedrockServiceUrl": "",
      "Secrets": {
        "AdminApiKeyName": "/gateway/prod/admin-api-key",
        "StsSigningKeyName": "/gateway/prod/sts-signing-key",
        "CacheSeconds": 300
      },
      "Crypto": {
        "KeyId": "alias/unified-gateway-prod",
        "EncryptionContext": {
          "application": "UnifiedLLMGateway",
          "environment": "production"
        }
      },
      "AccessControl": {
        "Enabled": true,
        "ServicePrefix": "gateway",
        "ResourceArnTemplate": "arn:aws:gateway:us-east-1:<account-id>:application/{0}",
        "DecisionCacheSeconds": 30,
        "AdminRoleArns": []
      },
      "Storage": {
        "//": "PROD: real S3. Create the bucket with versioning, SSE-KMS, Object Lock if required, and a lifecycle rule matching RetentionDays.",
        "Bucket": "unified-gateway-telemetry-prod",
        "FlushIntervalSeconds": 30,
        "FlushBatchSize": 100,
        "RetentionDays": 365,
        "RecentBufferSize": 500
      }
    },
    "Guardrails": {
      "Enabled": true,
      "Mode": "Redact",
      "Pci": {
        "Enabled": true,
        "MaskCreditCards": true,
        "MaskIban": true,
        "MaskCvv": true
      },
      "Pii": {
        "Enabled": true,
        "MaskSsn": true,
        "MaskEmails": true,
        "MaskPhoneNumbers": true,
        "MaskPassports": true
      },
      "Secrets": {
        "Enabled": true,
        "MaskAwsKeys": true,
        "MaskPrivateKeys": true,
        "MaskJwtTokens": true,
        "MaskGenericApiKeys": true
      },
      "PromptInjection": {
        "Enabled": true,
        "BlockJailbreaks": true,
        "BlockSystemOverrides": true
      },
      "BedrockGuardrails": {
        "Enabled": false,
        "GuardrailIdentifier": "",
        "GuardrailVersion": "DRAFT"
      },
      "OutputScanning": {
        "Enabled": true,
        "Mode": "Redact",
        "ScanPci": true,
        "ScanPii": true,
        "ScanSecrets": true
      }
    },
    "Okta": {
      "//": "Simulator off. The gateway validates real Okta tokens through OIDC discovery; validation and group-to-role mapping code is unchanged.",
      "Enabled": false,
      "Issuer": "https://<your-tenant>.okta.com/oauth2/default",
      "Audience": "unified-gateway",
      "MetadataAddress": "https://<your-tenant>.okta.com/oauth2/default/.well-known/openid-configuration",
      "GroupsClaim": "groups",
      "ClockSkewSeconds": 60,
      "GroupRoleMappings": {
        "UnifiedGateway-Admins": "arn:aws:iam::<account-id>:role/GatewayPlatformAdminRole",
        "UnifiedGateway-Developers": "arn:aws:iam::<account-id>:role/GatewayDeveloperRole"
      }
    },
    "Billing": {
      "Currency": "USD",
      "//DefaultCosts": "Applied when an application has no rate card, or a request carries no application. Such charges are flagged as estimated.",
      "DefaultInputCostPerMillion": 0.0,
      "DefaultOutputCostPerMillion": 0.0,
      "DailyWindowDays": 30,
      "WeeklyWindowWeeks": 12,
      "MonthlyWindowMonths": 12,
      "MonthlyBudget": 25000.0
    }
  }
}
